{
  "info": {
    "name": "在线考试微服务系统核心测试集合",
    "description": "包含整个系统中涉及到的8个核心关键接口：用户注册、登录、获取详情、题库新增、真题获取、试卷生成、算分提交。涵盖Feigns级联跨微服务测试场景。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 用户注册-学生账户",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student_001\",\n  \"password\": \"123456\",\n  \"nickname\": \"张华同学\",\n  \"role\": \"STUDENT\"\n}"
        },
        "url": { "raw": "http://localhost:8080/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "01 用户注册-教师账户",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"teacher_001\",\n  \"password\": \"123456\",\n  \"nickname\": \"李教授\",\n  \"role\": \"TEACHER\"\n}"
        },
        "url": { "raw": "http://localhost:8080/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "02 用户登录及Token生成",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.environment.set(\"token\", jsonData.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"student_001\",\n  \"password\": \"123456\"\n}"
        },
        "url": { "raw": "http://localhost:8080/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "03 获取当前认证用户信息",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "http://localhost:8080/api/auth/me", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "auth", "me"] }
      }
    },
    {
      "name": "04 题库录入试题A (教师专权)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Spring Cloud的网关核心路由组件是哪个？\",\n  \"optionA\": \"Ribbon\",\n  \"optionB\": \"Spring Cloud Gateway\",\n  \"optionC\": \"Nacos\",\n  \"optionD\": \"Eureka\",\n  \"answer\": \"B\",\n  \"score\": 10,\n  \"category\": \"Java开发\"\n}"
        },
        "url": { "raw": "http://localhost:8080/api/question/add", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "question", "add"] }
      }
    },
    {
      "name": "05 组卷发布考试 (教师专权)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"2026年Spring Cloud微服务专题小测\",\n  \"startTime\": \"2026-05-26T10:00:00.000+08:00\",\n  \"endTime\": \"2026-05-26T12:00:00.000+08:00\",\n  \"questionIds\": [1, 2, 3],\n  \"totalScore\": 100\n}"
        },
        "url": { "raw": "http://localhost:8080/api/exam/create", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "exam", "create"] }
      }
    },
    {
      "name": "06 获取公开可用试卷列表",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "http://localhost:8080/api/exam/list", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "exam", "list"] }
      }
    },
    {
      "name": "07 批量级联获取考卷问题详情-Feign客户端",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "http://localhost:8080/api/question/batch?ids=1,2", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "question", "batch"], "query": [{ "key": "ids", "value": "1,2" }] }
      }
    },
    {
      "name": "08 学生自动阅卷提交(跨微服务Feign RPC调用+算分)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"examId\": 1,\n  \"examTitle\": \"2026年Spring Cloud微服务专题小测\",\n  \"answers\": {\n    \"1\": \"B\",\n    \"2\": \"C\"\n  }\n}"
        },
        "url": { "raw": "http://localhost:8080/api/score/submit", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "score", "submit"] }
      }
    }
  ]
}
